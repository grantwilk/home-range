{
  "name": "home-range",
  "version": "1.1.2",
  "description": "An interactive U.S. map for finding places to live.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write *.html *.js *.css scripts/*.mjs tests/*.mjs",
    "lint": "eslint . && prettier --check *.html *.js *.css scripts/*.mjs tests/*.mjs",
    "prestart": "npm run build",
    "start": "python3 -m http.server 4178 --bind 127.0.0.1 --directory dist",
    "build": "node scripts/package.mjs",
    "browser": "node tests/browser.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "fontkit": "3.0.0",
    "globals": "^17.14.0",
    "pdfjs-dist": "6.5.438",
    "pdfkit": "0.21.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "svg-to-pdfkit": "0.1.8",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "private": true
}
